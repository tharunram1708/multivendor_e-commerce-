APP_NAME="Multi Vendor E-Commerce API"
DEBUG=false

# Create this database in MySQL first:
# CREATE DATABASE multivendor_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL="mysql+pymysql://root:root@localhost:3306/multivendor_db"

SECRET_KEY="replace-with-a-long-random-secret"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=20

# Keep false in normal development and use Alembic migrations.
CREATE_TABLES_ON_STARTUP=false

# Optional seed user. Works only when CREATE_TABLES_ON_STARTUP=true or after tables exist.
FIRST_SUPER_ADMIN_EMAIL="admin@example.com"
FIRST_SUPER_ADMIN_PASSWORD="Admin@12345"

